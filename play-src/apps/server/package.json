{
  "name": "@bitblitz/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --port 8787 --ip 0.0.0.0",
    "setup:dev": "tsx scripts/write-dev-vars.ts",
    "hash-passphrase": "tsx scripts/hash-passphrase.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@bitblitz/engine": "workspace:*",
    "@bitblitz/schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
