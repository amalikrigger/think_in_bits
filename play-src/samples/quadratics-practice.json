{
  "schemaVersion": 1,
  "title": "1.1 Quadratics: practice",
  "description": "Roots, completing the square, the discriminant and inequalities. Public practice sample; autoplay on.",
  "settings": { "autoplay": true, "revealSec": 5, "leaderboardSec": 5 },
  "defaults": { "timeLimitSec": 20, "points": "standard" },
  "questions": [
    { "type": "single", "prompt": "Solve $x^2-5x+6=0$.",
      "answers": [ {"text": "$x=2$ or $x=3$", "correct": true}, {"text": "$x=-2$ or $x=-3$"}, {"text": "$x=1$ or $x=6$"}, {"text": "$x=-1$ or $x=-6$"} ],
      "explanation": "$(x-2)(x-3)=0$." },
    { "type": "single", "prompt": "Complete the square: $x^2+6x+2$", "timeLimitSec": 30,
      "answers": [ {"text": "$(x+3)^2+2$"}, {"text": "$(x+3)^2-7$", "correct": true}, {"text": "$(x+6)^2-34$"}, {"text": "$(x-3)^2-7$"} ],
      "explanation": "Halve the 6: $(x+3)^2-9+2=(x+3)^2-7$." },
    { "type": "single", "prompt": "Vertex of $y=(x-4)^2+1$?",
      "answers": [ {"text": "$(-4, 1)$"}, {"text": "$(4, -1)$"}, {"text": "$(4, 1)$", "correct": true}, {"text": "$(1, 4)$"} ],
      "explanation": "$y=(x-p)^2+q$ has its vertex at $(p, q)$." },
    { "type": "single", "prompt": "Discriminant of $2x^2+3x-5$?", "timeLimitSec": 30,
      "answers": [ {"text": "$-31$"}, {"text": "$1$"}, {"text": "$19$"}, {"text": "$49$", "correct": true} ],
      "explanation": "$b^2-4ac = 9-4(2)(-5) = 9+40 = 49$." },
    { "type": "true_false", "prompt": "If $b^2-4ac<0$, the quadratic has two real roots.", "correct": false, "timeLimitSec": 10,
      "explanation": "A negative discriminant means no real roots." },
    { "type": "single", "prompt": "How many real roots does $x^2+4x+4=0$ have?",
      "answers": [ {"text": "One (repeated)", "correct": true}, {"text": "Two"}, {"text": "None"}, {"text": "Infinitely many"} ],
      "explanation": "$(x+2)^2=0$; the discriminant is $16-16=0$." },
    { "type": "multi", "prompt": "Which have two distinct real roots? Select all that apply.", "timeLimitSec": 30,
      "answers": [ {"text": "$x^2-1=0$", "correct": true}, {"text": "$x^2+1=0$"}, {"text": "$x^2-4x+3=0$", "correct": true}, {"text": "$x^2-2x+1=0$"} ],
      "explanation": "Discriminants: $4$, $-4$, $4$ and $0$. Only positive means two distinct roots." },
    { "type": "single", "prompt": "Solve $x^2-9<0$.", "timeLimitSec": 30,
      "answers": [ {"text": "$x<-3$ or $x>3$"}, {"text": "$-3<x<3$", "correct": true}, {"text": "$x<3$"}, {"text": "$x<9$"} ],
      "explanation": "The parabola dips below zero between its roots $-3$ and $3$." },
    { "type": "single", "prompt": "Solve $x^2-x-6>0$.", "timeLimitSec": 30,
      "answers": [ {"text": "$-2<x<3$"}, {"text": "$x>3$"}, {"text": "$x<-2$ or $x>3$", "correct": true}, {"text": "$x<-3$ or $x>2$"} ],
      "explanation": "$(x-3)(x+2)>0$ outside the roots." },
    { "type": "single", "prompt": "For which $k>0$ does $x^2+kx+9=0$ have equal roots?", "points": "double", "timeLimitSec": 30,
      "answers": [ {"text": "$k=3$"}, {"text": "$k=9$"}, {"text": "$k=18$"}, {"text": "$k=6$", "correct": true} ],
      "explanation": "Equal roots: $k^2-36=0$, so $k=6$." }
  ]
}
